# 站点的对外地址，用于 RSS、分享卡片等（Vercel 上可留空，会自动使用 VERCEL_URL）
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# 内容后台登录：GitHub OAuth App 的 Client ID / Client Secret（见 README「部署」一节）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 可选：允许发起后台登录的域名，逗号分隔，支持 * 通配，例如 wenwen.example.com,*-wenwen.vercel.app
# 不填时只信任站点自身域名
ALLOWED_DOMAINS=
