# 站点的对外地址，用于 RSS、分享卡片等（Vercel 上可留空，会自动使用 VERCEL_URL）
NEXT_PUBLIC_SITE_URL=https://example.vercel.app

# 内容后台登录：GitHub OAuth App 的 Client ID / Client Secret（见 README「部署」一节）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 可选：允许发起后台登录的域名，逗号分隔，支持 * 通配，例如 wenwen.example.com,*-wenwen.vercel.app
# 不填时只信任站点自身域名
ALLOWED_DOMAINS=

# —— 账号与投稿（公开上线时配置）——
# 登录会话签名密钥：填一段随机长字符串（至少 16 位）
AUTH_SECRET=
# 管理员邮箱，逗号分隔；只有这些账号能进入 /review 审核投稿
ADMIN_EMAILS=
# 可追加管理员邮箱，逗号分隔；无需覆盖已有 ADMIN_EMAILS
ADMIN_EMAILS_EXTRA=
# Vercel Blob 读写令牌：在 Vercel 控制台创建 Blob 存储后自动注入（本地开发可留空）
BLOB_READ_WRITE_TOKEN=
# 审核通过后自动提交稿件到仓库（细粒度令牌，需要 Contents: Read and write）
GITHUB_REPO=OWNER/REPO
GITHUB_TOKEN=
# 可选，默认 main
GITHUB_BRANCH=main
